    "blendshape_dimensions": 52,
    "blendshape_standard": "ARKit / MediaPipe Face Landmarker 52 Blendshapes",
    "geometric_metrics": [
      "mouthOpenRatio",
      "mouthWidthRatio",
      "eyeOpenRatio",
      "browRaiseRatio",
      "mouthCornerTilt"
    ],
    "pose_dimensions": 3,
    "normalization": "Scale-invariant relative to inter-ocular distance (IOD = ||P_leftEye - P_rightEye||)"
  },
  "score_tiers": {
    "flawless": [90, 100],
    "great": [75, 89],
    "good": [60, 74],
    "fair": [40, 59],
    "retry": [0, 39]
