# Copy this file to `.env` (same folder) and fill in what you use. Never commit `.env`.
#
# ─── Frontend (anything prefixed VITE_ is shipped to the browser — public values ONLY) ───
#
# Optional: live online leaderboards via Supabase.
# Without these, Fun Spot runs fully offline and saves scores in the browser (localStorage).
#   1. Create a Supabase project and run supabase/migrations/001_leaderboard.sql,
#      then 002_wrong_answers.sql, in its SQL editor.
#   2. Fill in Project Settings → API values below.
# Use the PUBLIC "anon" key only. NEVER put the service_role key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional: Google Drive OAuth Client ID for direct Look A Like souvenir uploads
# into the "Fun Spot - Look A Like" folder.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ─── Backend (read only by backend/app.py — never reaches the browser) ───
#
# AI judge for Wrong Answers Only!! (Anthropic Claude). Without a key the game still
# works and uses clearly-labelled backup scoring.
AI_API_KEY=your_api_key_here
# Optional overrides:
# AI_MODEL=claude-opus-5-5
# AI_TIMEOUT_SECONDS=20
